      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:9px 14px;border:1px solid transparent;border-radius:var(--radius,8px);font:600 13px/1.35 -apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif;cursor:pointer;transition:background 160ms ease,color 160ms ease}.ds-button:focus-visible{outline:3px solid var(--focus,#2254db);outline-offset:3px}.ds-button:disabled{opacity:.48;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--primary,#2254db);color:#fff;}.ds-primary:hover{background:var(--primary-hover,#1943b6)}@media(max-width:767px){.ds-button{min-height:44px}}"

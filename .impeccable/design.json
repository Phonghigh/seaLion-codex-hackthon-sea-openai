  "narrative": {
    "northStar": "Operate \u2014 a calm working surface",
    "overview": "The shared interface uses restrained teal, pale green neutrals and clear pane boundaries. Customer support feels reassuring and spacious; the CS workspace is compact and evidence-led. Both use familiar task controls and precise status copy.\n\nThis is a code-led record of the current local frontend. Source files are `packages/ui/src/styles.css`, `packages/ui/src/index.tsx` and the components in both apps. Page strategy remains in `.impeccable/surfaces/`; this document records shared visual behavior.",
    "keyCharacteristics": [
      "Restrained teal actions on pale neutral surfaces.",
      "Spacious customer conversation; compact agent workspace.",
      "Source labels, explicit approval controls and honest demo status."
    ],
    "rules": [
      {
        "name": "The Source Label Rule",
        "body": "Preserve the visible source word; color alone never establishes a fact's provenance.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and tonal differences for ordinary containers; reserve the structural shadow for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the spacious customer layout and compact agent layout within the shared palette.",
      "Do show source words, readable status text and explicit approval actions.",
      "Do retain visible keyboard focus, labelled controls and reduced-motion behavior.",
      "Do describe placeholder evidence and local operations accurately."
    ],
    "donts": [
      "Don't add decorative dashboard metrics to these task surfaces.",
      "Don't use color alone to distinguish fact source or operation status.",
      "Don't turn ordinary case sections into raised cards.",
      "Don't present a seeded attachment as a verified customer photo."
    ]
  }
}

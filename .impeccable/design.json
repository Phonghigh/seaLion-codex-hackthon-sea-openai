      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:9px 14px;border:1px solid transparent;border-radius:var(--radius,8px);font:600 13px/1.35 Arial,Helvetica,sans-serif;cursor:pointer;transition:background 160ms ease,color 160ms ease}.ds-button:focus-visible{outline:3px solid var(--focus,#318773);outline-offset:3px}.ds-button:disabled{opacity:.48;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--primary,#176b59);color:#fff;}.ds-primary:hover{background:var(--primary-hover,#105342)}@media(max-width:767px){.ds-button{min-height:44px}}"

{
  "name": "seapilot",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @seapilot/customer --filter @seapilot/customer-service dev",
    "dev:customer": "pnpm --filter @seapilot/customer dev",
    "dev:cs": "pnpm --filter @seapilot/customer-service dev",
    "build": "pnpm --filter @seapilot/customer build && pnpm --filter @seapilot/customer-service build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint apps packages",
    "test": "vitest run && node --test tests/codex-usage.test.mjs",
    "test:frontend": "vitest run",
    "dev:api": "pnpm --filter @seapilot/api dev",
    "db:generate": "pnpm --filter @seapilot/api db:generate",
    "db:migrate": "pnpm --filter @seapilot/api db:migrate",
    "db:reset": "pnpm --filter @seapilot/api db:reset",
    "test:api": "vitest run apps/api/src",
    "test:api:integration": "vitest run --config apps/api/vitest.integration.config.ts",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:4000"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vitest": "3.2.7",
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
